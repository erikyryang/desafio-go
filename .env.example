# Copy to .env when running the binary on the host (docker compose services use
# their own values from docker-compose.yml). All values are local examples.

INSTANCE_ID=local-1
LOG_LEVEL=info
HTTP_ADDR=:8081

# PostgreSQL
DATABASE_URL=postgres://wager:wager@localhost:5432/wager?sslmode=disable
DB_MAX_CONNS=20
MIGRATE_ON_START=false

# SQS (LocalStack)
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_WAGER_QUEUE_NAME=wager-transactions.fifo
SQS_WAGER_DLQ_NAME=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_NAME=wallet-events.fifo

# OIDC (Keycloak). The issuer is the value in the "iss" claim; the JWKS URL is
# where this process fetches keys (differs inside docker: http://keycloak:8080/...).
OIDC_ISSUER=http://localhost:8080/realms/wager
OIDC_JWKS_URL=http://localhost:8080/realms/wager/protocol/openid-connect/certs
OIDC_AUDIENCE=wager-api

# SQS consumer
CONSUMER_ENABLED=true
CONSUMER_WAIT_TIME=10s
CONSUMER_MAX_MESSAGES=10
CONSUMER_VISIBILITY_TIMEOUT=30s
CONSUMER_DRAIN_TIMEOUT=15s

# Outbox publisher
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE=30s
OUTBOX_INITIAL_BACKOFF=1s
OUTBOX_MAX_BACKOFF=1m

# Pending reference worker (REFUND/ROLLBACK arriving before their reference)
PENDING_WORKER_ENABLED=true
PENDING_POLL_INTERVAL=1s
PENDING_BATCH_SIZE=50
PENDING_INITIAL_BACKOFF=2s
PENDING_MAX_BACKOFF=1m
PENDING_MAX_ATTEMPTS=10
PENDING_TTL=15m

SHUTDOWN_TIMEOUT=25s

# Crash points for recovery demos (comma separated):
#   consumer-after-commit, outbox-after-publish
FAULT_INJECT=

# Test identities (Keycloak realm "wager", provisioned automatically)
#   provider-a / provider-a-secret        role wager:provider, providerId=provider-a
#   provider-b / provider-b-secret        role wager:provider, providerId=provider-b
#   internal-service / internal-service-secret   role wager:internal
